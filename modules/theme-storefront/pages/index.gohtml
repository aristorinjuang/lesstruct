{{- define "body"}}
<header class="container listing-head">
	<p class="eyebrow">{{if eq .Lang "id"}}Koleksi{{else}}Collection{{end}}</p>
	<h1>{{.Title}}</h1>
	{{- if .Description}}<p class="listing-head__sub">{{.Description}}</p>{{end}}
	{{- if .Tags}}
	<div class="collection-nav">
		<a class="chip chip--active" href="{{.CurrentPath}}">{{if eq .Lang "id"}}Semua{{else}}All{{end}}</a>
		{{- range .Tags}}<a class="chip" href="/tags/{{. | urlpath}}">{{.}}</a>{{end}}
	</div>
	{{- end}}
</header>
<section class="container">
	<div class="product-grid">
		{{- range .Posts}}{{template "product-card" .}}{{else}}<p class="empty">{{t .Lang "ui.no_posts"}}</p>{{end}}
	</div>
	{{- if or .HasPrev .HasNext}}
	<nav class="pagination" aria-label="Pagination">
		{{- if .HasPrev}}<a rel="prev" href="{{.PrevURL}}">{{t .Lang "ui.prev_page"}}</a>{{end}}
		{{- if .HasNext}}<a rel="next" href="{{.NextURL}}">{{t .Lang "ui.next_page"}}</a>{{end}}
	</nav>
	{{- end}}
</section>
{{- end}}
