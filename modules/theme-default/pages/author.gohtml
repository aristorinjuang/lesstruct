{{- define "body"}}
<div class="author-page container">
	{{- if .AuthorAvatarURL}}<img src="{{.AuthorAvatarURL}}" class="author-page-avatar" alt="{{.AuthorName}}">{{end}}
	<h1>{{.AuthorName}}</h1>
	{{- if .CustomFieldsFormatted}}
	<section class="custom-fields" aria-label="About the Author">
		<dl class="custom-fields-list">
			{{- range .CustomFieldsFormatted}}
			<dt>{{.Label}}</dt>
			<dd>{{.Value}}</dd>
			{{- end}}
		</dl>
	</section>
	{{- end}}
	<div class="posts-grid">
		{{- range $i, $post := .Posts}}
		<article class="post-card" data-post-type="{{$post.PostType}}">
			<a href="/{{$post.Slug}}">
				{{- if $post.ImageURL}}<picture>{{if $post.ImageMobileURL}}<source media="(max-width: 767px)" srcset="{{$post.ImageMobileURL}}">{{end}}<img src="{{$post.ImageURL}}" alt="{{$post.Title}}" class="post-card__image"{{if eq $i 0}} loading="eager" fetchpriority="high"{{else}} loading="lazy" decoding="async"{{end}}></picture>{{end}}
				<h2>{{$post.Title}}</h2>
				{{- if $post.MetaDescription}}<p>{{$post.MetaDescription}}</p>{{end}}
				<time>{{formatDate $.Lang $post.CreatedAt}}</time>
			</a>
		</article>
		{{- else}}
		<p class="empty">{{t .Lang "ui.no_posts"}}</p>
		{{- end}}
	</div>
	{{- if or .HasPrev .HasNext}}
	<nav class="pagination" aria-label="Pagination">
		{{- if .HasPrev}}<a rel="prev" href="{{.PrevURL}}">{{t .Lang "ui.prev_page"}}</a>{{end}}
		{{- if .HasNext}}<a rel="next" href="{{.NextURL}}">{{t .Lang "ui.next_page"}}</a>{{end}}
	</nav>
	{{- end}}
</div>
{{- end}}