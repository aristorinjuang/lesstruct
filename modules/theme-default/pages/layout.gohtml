{{- define "layout"}}<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{.PageTitle}}</title>
	{{- $desc := .Description}}{{- if not $desc}}{{- if eq .Lang "id"}}{{- $desc = print .SiteConfig.Name " — artikel, panduan, dan kabar terbaru."}}{{- else}}{{- $desc = print .SiteConfig.Name " — articles, guides, and updates."}}{{- end}}{{- end}}
	<meta name="description" content="{{$desc}}">
	<meta property="og:title" content="{{.OGTitle}}">
	<meta property="og:description" content="{{if .OGDesc}}{{.OGDesc}}{{else}}{{$desc}}{{end}}">
	{{- if .OGImage}}<meta property="og:image" content="{{.OGImage}}">{{end}}
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="{{.SiteConfig.Name}}">
	<meta name="twitter:card" content="summary_large_image">
	{{- if .OGImage}}<meta name="twitter:image" content="{{.OGImage}}">{{end}}
	{{- if .SiteConfig.Favicon}}
	<link rel="icon" href="{{.SiteConfig.Favicon}}">
	<link rel="apple-touch-icon" href="{{.SiteConfig.Favicon}}">
	{{- else}}
	<link rel="icon" type="image/png" href="/static/favicon-96x96.png" sizes="96x96">
	<link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
	<link rel="shortcut icon" href="/static/favicon.ico">
	<link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png">
	{{- end}}
	<link rel="preload" as="font" type="font/woff2" crossorigin href="/static/inter-latin-var.woff2">
	{{inlineStyles}}
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" media="print" onload="this.media='all'">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.11.1/styles/github-dark.min.css" media="print" onload="this.media='all'">
	<noscript>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.11.1/styles/github-dark.min.css">
	</noscript>
</head>
<body>
	<header class="site-header">
		<div class="container">
			<a href="/" class="site-logo">{{if .SiteConfig.Logo}}<img src="{{.SiteConfig.Logo}}" alt="{{.SiteConfig.Name}}">{{else}}{{.SiteConfig.Name}}{{end}}</a>
			<div class="nav-wrapper">
				<div class="site-search"><button class="search-toggle" aria-label="{{t .Lang "ui.search"}}" type="button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button><div class="search-box"><input type="search" id="search-input" class="search-input" placeholder="{{t .Lang "ui.search_posts"}}" autocomplete="off" aria-label="{{t .Lang "ui.search_posts"}}"><div id="search-dropdown" class="search-dropdown" role="listbox" style="display:none"></div></div></div>
				<button class="nav-toggle" aria-label="{{t .Lang "ui.toggle_navigation"}}" aria-expanded="false"><span></span><span></span><span></span><span></span></button>
				<nav class="site-nav">
					{{- range .NavigationItems}}
					<a href="{{.URL}}"{{if .IsActive}} class="active"{{end}}>{{.Title}}</a>
					{{- end}}
					{{- if .Languages}}
					<select id="language-select" class="language-select" aria-label="Language" hidden>
						{{- range .Languages}}<option value="{{.URL}}"{{if eq .Code $.Lang}} selected{{end}}>{{upper .Code}}</option>{{end}}
					</select>
					<noscript><span>{{- range .Languages}} <a href="{{.URL}}" hreflang="{{.Code}}" class="lang-link">{{upper .Code}}</a>{{end}}</span></noscript>
					{{- end}}
					<a id="nav-login" href="/login">{{t .Lang "ui.login"}}</a><a id="nav-logout" href="/" style="display:none">{{t .Lang "ui.logout"}}</a>
				</nav>
				<script>(function(){var s=document.getElementById('language-select');if(!s)return;if(!s.options.length)return;s.removeAttribute('hidden');s.addEventListener('change',function(){if(s.value)window.location.href=s.value;});})();</script>
			</div>
		</div>
	</header>
	<main>
		{{- template "body" .}}
	</main>
	<footer class="site-footer">
		<div class="container">
			{{- if .FooterItems}}
			<nav class="site-footer__nav">
				{{- range .FooterItems}}<a href="{{.URL}}">{{.Title}}</a>{{end}}
			</nav>
			{{- end}}
			<p>&copy; {{.SiteConfig.Name}}</p>
		</div>
	</footer>
	<div id="cookie-banner" class="cookie-banner" role="region" aria-label="{{t .Lang "ui.cookie_notice"}}" hidden>
		<p>{{.Legal.CookieNotice.Before}}{{if .Legal.CookieNotice.LinkText}}{{if .Legal.CookieNotice.URL}}<a href="{{.Legal.CookieNotice.URL}}">{{.Legal.CookieNotice.LinkText}}</a>{{else}}{{.Legal.CookieNotice.LinkText}}{{end}}{{end}}{{.Legal.CookieNotice.After}}</p>
		<div class="cookie-banner__actions">
			<button type="button" id="cookie-accept">{{t .Lang "ui.cookie_accept"}}</button>
			<button type="button" id="cookie-decline">{{t .Lang "ui.cookie_decline"}}</button>
		</div>
	</div>
	<script>(function(){function c(){var m=document.cookie.match(/(?:^|;\s*)lesstruct_consent=([^;]*)/);return m?decodeURIComponent(m[1]).replace(/^\s+|\s+$/g,''):'';}function s(v){var h=location.protocol==="https:"?"; Secure":"";document.cookie="lesstruct_consent="+encodeURIComponent(v)+"; Path=/; Max-Age=31536000; SameSite=Lax"+h;}var b=document.getElementById('cookie-banner');if(!b)return;var v=c();if(v==='accepted'||v==='declined'){b.setAttribute('hidden','');return;}b.removeAttribute('hidden');var a=document.getElementById('cookie-accept');var d=document.getElementById('cookie-decline');if(a)a.addEventListener('click',function(){s('accepted');b.setAttribute('hidden','');});if(d)d.addEventListener('click',function(){s('declined');b.setAttribute('hidden','');try{localStorage.removeItem('lesstruct_currency');}catch(_){}document.cookie='lesstruct_lang=; Path=/; Max-Age=0; SameSite=Lax'+(location.protocol==="https:"?"; Secure":"');});})();</script>
	<script src="/static/nav-auth.js" defer></script>
	<script src="/static/search.js" defer></script>
	<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" defer></script>
	<script defer src="/static/math.js"></script>
	<script src="/static/highlight.min.js" defer></script>
	<script>document.addEventListener('DOMContentLoaded', function() { hljs.highlightAll() })</script>
</body>
</html>
{{- end}}