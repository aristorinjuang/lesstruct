# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration
# DB_DRIVER: sqlite (default), postgres, or mysql
DB_DRIVER=sqlite
# DB_PATH: SQLite database file path (used when DB_DRIVER=sqlite)
DB_PATH=data/lesstruct.db
# DB_DSN: PostgreSQL connection string (required when DB_DRIVER=postgres)
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# DB_DSN=postgres://lesstruct:lesstruct@localhost:5432/lesstruct?sslmode=disable
# DB_DSN: MySQL connection string (required when DB_DRIVER=mysql)
# Format: user:password@tcp(host:port)/dbname?parseTime=true&multiStatements=true&charset=utf8mb4&collation=utf8mb4_general_ci
# NOTE: parseTime=true is REQUIRED — without it DATE/DATETIME columns scan as []byte, not time.Time
# NOTE: multiStatements=true is REQUIRED — without it golang-migrate cannot run migrations with multiple SQL statements
# DB_DSN=lesstruct:lesstruct@tcp(localhost:3306)/lesstruct?parseTime=true&multiStatements=true&charset=utf8mb4&collation=utf8mb4_general_ci
# DB_POOL_MAX_CONNS: Connection pool size for client-server drivers (default: 20, used with postgres and mysql)
# DB_POOL_MAX_CONNS=20
# TEST_POSTGRES_DSN: PostgreSQL connection string for integration tests (only used with -tags postgresql)
# TEST_POSTGRES_DSN=postgres://lesstruct:lesstruct@localhost:5432/lesstruct_test?sslmode=disable
# TEST_MYSQL_DSN: MySQL connection string for integration tests (only used with -tags mysql)
# TEST_MYSQL_DSN=lesstruct:lesstruct@tcp(localhost:3306)/lesstruct_test?parseTime=true&charset=utf8mb4&collation=utf8mb4_general_ci

# Storage Configuration
# STORAGE_DRIVER: local (default) or s3
# The "s3" driver works against BOTH AWS S3 and MinIO (both speak the S3 API).
# Files are served to clients from the public base URL (bucket or CDN) — see
# STORAGE_S3_PUBLIC_BASE_URL.
STORAGE_DRIVER=local
# STORAGE_S3_ENDPOINT: S3-compatible endpoint URL. Leave EMPTY for AWS S3.
# Set for MinIO, e.g. STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ENDPOINT=
# STORAGE_S3_REGION: AWS region, or "us-east-1" for MinIO (its default)
STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET: bucket holding media and profile pictures (required when STORAGE_DRIVER=s3)
STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID / STORAGE_S3_SECRET_ACCESS_KEY: static credentials (required when STORAGE_DRIVER=s3)
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_USE_PATH_STYLE: true for MinIO (path-style addressing), false for AWS
STORAGE_S3_USE_PATH_STYLE=false
# STORAGE_S3_PUBLIC_BASE_URL: public base URL served to clients, e.g. the bucket's
# public URL or a CDN/CloudFront distribution. Required when STORAGE_DRIVER=s3.
# Example: https://cdn.example.com
STORAGE_S3_PUBLIC_BASE_URL=

# JWT Configuration
JWT_SECRET=change_this_secret_in_production

# Logging
LOG_LEVEL=info

# SMTP Configuration
# Required for login: every account completes an emailed one-time code after
# the password step. With SMTP unconfigured, login fails closed (503) unless
# DEV_MODE=true, in which case the code is written to stdout instead. The
# seeded admin's pre-setup login is the only bootstrap exception: it returns
# firstLoginRequired (no session) so the setup page can set a real email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

# CORS Configuration
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
# Include the protocol (http/https), domain, and port if applicable
# Example: http://localhost:5173,http://localhost:3000,https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Site Configuration
# Base URL of the site (used for email verification links, password reset links, etc.)
# An https:// origin enables HSTS (Strict-Transport-Security, one year) automatically.
SITE_URL=http://localhost:8080
# HSTS max-age in seconds; overrides the SITE_URL derivation (0 disables the header)
# HSTS_MAX_AGE_SECONDS=31536000

# Development Mode
# Set to true to proxy frontend requests to dev servers instead of embedded assets
# When true AND SMTP is unconfigured, emailed login codes are written to stdout.
DEV_MODE=false
ADMIN_DEV_URL=http://localhost:5173

# Rate Limiting
# Master toggle for rate limiting (set false to disable)
RATE_LIMIT_ENABLED=true
# Requests per minute for authentication endpoints (login, register, forgot-password, reset-password)
RATE_LIMIT_AUTH_PER_MINUTE=5
# Requests per minute for authenticated API endpoints
RATE_LIMIT_API_PER_MINUTE=100
# Requests per minute for public content delivery endpoints
RATE_LIMIT_PUBLIC_PER_MINUTE=60
# Bearer 401 responses per minute per IP before further /api/v1 requests are refused
RATE_LIMIT_AGENT_FAILURES_PER_MINUTE=15

# Import Configuration
# Max upload size in megabytes for any importer (e.g. WordPress WXR export).
# WordPress exports commonly reach tens or hundreds of MB for real sites.
IMPORT_MAX_SIZE_MB=100
# Max duration for a WordPress import job (Go duration string, e.g. "4h", "90m").
# Imports run asynchronously after the HTTP response; increase for very large exports.
# WORDPRESS_IMPORT_TIMEOUT=2h
# Max duration for a Hugo import job (Go duration string, e.g. "10m", "30m").
# Imports run asynchronously after the HTTP response; increase for sites with many images.
# HUGO_IMPORT_TIMEOUT=10m

# Server Timeouts
# How long to wait for request headers (Slowloris protection; set to 0 to disable).
# SERVER_READ_HEADER_TIMEOUT=15s
# How long to wait for the entire request including the body (0 = no timeout).
# Body size is capped per-handler via IMPORT_MAX_SIZE_MB and max body size middleware.
# SERVER_READ_TIMEOUT=0
# How long to wait for response writes after headers are read (0 = no timeout).
# Per-handler context deadlines (e.g. WORDPRESS_IMPORT_TIMEOUT) bound long operations.
# SERVER_WRITE_TIMEOUT=0

# AI Image Generation (optional)
# Set AI_IMAGE_GENERATION_API_KEY to enable AI image generation in the admin panel
# When enabled, a "Generate with AI" button appears in the Media Library and Content Editor
# Supported models:
#   Google Gemini (prefix "gemini-"): gemini-3.1-flash-image, gemini-3-pro-image, gemini-2.5-flash-image
#   Google Imagen 4: imagen-4.0-generate-001, imagen-4.0-fast-generate-001, imagen-4.0-ultra-generate-001
#   GPT Image: gpt-image-1, gpt-image-1-mini, gpt-image-1.5, gpt-image-2
#   Meta Muse Image (prefix "muse-image-", needs AI_IMAGE_GENERATION_BASE_URL): muse-image-1.0
# AI_IMAGE_GENERATION_BASE_URL is optional — set it for OpenAI-compatible providers
# Example for Meta Model API (Muse Image): AI_IMAGE_GENERATION_BASE_URL=https://api.meta.ai/v1
AI_IMAGE_GENERATION_API_KEY=
AI_IMAGE_GENERATION_BASE_URL=
AI_IMAGE_GENERATION_MODEL=imagen-4.0-fast-generate-001
AI_IMAGE_GENERATION_SIZE=
AI_IMAGE_GENERATION_ASPECT_RATIO=

# AI Text Generation (optional)
# Set AI_TEXT_GENERATION_API_KEY to enable AI text enhancement and translation in the admin panel
# Works with any OpenAI-compatible API (OpenAI, OpenRouter, Together, Groq, Ollama, etc.)
# AI_TEXT_GENERATION_BASE_URL is optional — defaults to OpenAI's API; set it for other providers
# Example for OpenRouter: AI_TEXT_GENERATION_BASE_URL=https://openrouter.ai/api/v1
# Example for Ollama: AI_TEXT_GENERATION_BASE_URL=http://localhost:11434/v1
AI_TEXT_GENERATION_API_KEY=
AI_TEXT_GENERATION_BASE_URL=
# AI_TEXT_GENERATION_MODEL is the chat model to use (defaults to gpt-5-mini)
# Examples by provider:
#   OpenAI:          gpt-5.4-mini, gpt-5-mini
#   OpenRouter:      openai/gpt-5.4-mini, anthropic/claude-sonnet-4.6, google/gemini-3.5-flash
#   Together AI:     meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
#   Groq:            llama-3.3-70b-versatile, mixtral-8x7b-32768
#   Ollama (local):  llama3, mistral, gemma3
AI_TEXT_GENERATION_MODEL=gpt-5-mini

# Privacy redaction via Meta SAM 3.1 (optional)
# Set AI_SAM_API_KEY to scan every media and profile-picture upload and blur
# sensitive regions before anything is stored. Empty keeps the legacy pipeline
# byte-identical. Any scan failure rejects the upload fail-closed and stores
# nothing. Faces stay visible only in profile pictures, blurred everywhere else.
# No admin UI toggle, no backfill, no importer or AI-generated image scanning in v1.
AI_SAM_API_KEY=
AI_SAM_MODEL=sam-3.1
AI_SAM_CONCEPTS=face,license plate,nudity

# AI Speech-to-Text / Voice Dictation (optional)
# Set AI_SPEECH_TO_TEXT_API_KEY *and* AI_TEXT_GENERATION_API_KEY to enable the
# "Dictate with AI" button in the content editor: up to 5 minutes of speech is
# transcribed, then enhanced into TipTap content with a suggested title and
# meta description (previewed before inserting).
# Works with Meta Model API (Muse Voice Transcribe, default) or any
# OpenAI-compatible transcription endpoint (Whisper, Groq, self-hosted).
# AI_SPEECH_TO_TEXT_BASE_URL is optional — defaults to Meta's API; set it to
# the server root for other providers (e.g. http://localhost:11434/v1).
# AI_SPEECH_TO_TEXT_PROVIDER is "meta" (default) or "openai".
AI_SPEECH_TO_TEXT_API_KEY=
AI_SPEECH_TO_TEXT_BASE_URL=https://api.meta.ai
AI_SPEECH_TO_TEXT_MODEL=muse-voice-transcribe-1.0
AI_SPEECH_TO_TEXT_PROVIDER=meta

# MIDTRANS_SERVER_KEY enables the Midtrans Snap hosted checkout when the
# [payments] methods list includes "midtrans". An unset key keeps the
# store on manual transfer proofs only. Secrets belong here, never in
# config.toml. Shape: SB-Mid-server-… on sandbox, Mid-server-… on
# production (a Merchant-ID-shaped value is warned about at startup).
MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION switches the Snap base URL: "true" serves the
# production gateway, anything else (default) the sandbox.
MIDTRANS_IS_PRODUCTION=false

# PII_MASTER_KEY is the base64-encoded 32-byte master key for commerce PII
# encryption (order customer fields, payment proof reference and verifier).
# Generate with: openssl rand -base64 32
# REQUIRED by the lesstruct-ecommerce binary: a missing or invalid key
# fails startup closed instead of serving customer PII in plaintext.
# The blog and core editions ignore it.
PII_MASTER_KEY=
