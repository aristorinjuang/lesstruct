{{- define "body"}}
<div class="auth-page container">
	<div class="auth-card">
		<p class="eyebrow">{{if eq .Lang "id"}}Akun{{else}}Account{{end}}</p>
		<h1>{{t .Lang "ui.verify_email_title"}}</h1>
		<div id="auth-error" class="auth-error alert alert--error" role="alert" style="display:none"></div>
		<div id="auth-success" class="auth-success alert alert--success" role="status" style="display:none">
			<p id="email-verified-message">{{t .Lang "ui.email_verified"}}</p>
			<p id="email-verified-approval-message" style="display:none">{{t .Lang "ui.email_verified_awaiting_approval"}}</p>
			<p><a href="/login">{{t .Lang "ui.login_to_account"}}</a></p>
		</div>
		<div class="auth-links">
			<p><a href="/login">{{t .Lang "ui.back_to_login"}}</a></p>
		</div>
	</div>
</div>
<script src="/static/verify-email.js"></script>
{{- end}}
